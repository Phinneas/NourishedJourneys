# Route consolidation redirects (301) — absorb duplicate URLs removed from the build.
# Duplicate post route /posts/{slug}/ -> canonical /{slug}/
/posts/:slug/  /:slug/  301
/posts/:slug   /:slug/  301

# Duplicate tag route /tag/{tag}/ -> canonical /tags/{tag}/
/tag/:tag/     /tags/:tag/1/  301
/tag/:tag/:page/  /tags/:tag/:page/  301

