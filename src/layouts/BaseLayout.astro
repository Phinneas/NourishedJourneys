---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
const { title, description } = Astro.props;
import "../assets/app.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      body {
        background-color: #F7F5F0 !important;
        color: #16213E;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .page-bg {
        position: fixed;
        inset: 0;
        background: 
            radial-gradient(ellipse at 20% 50%, rgba(139, 157, 131, 0.08) 0%, transparent 50%),
            radial-gradient(ellipse at 80% 30%, rgba(212, 163, 115, 0.06) 0%, transparent 50%),
            radial-gradient(ellipse at 50% 80%, rgba(139, 157, 131, 0.05) 0%, transparent 50%);
        pointer-events: none;
        z-index: -1;
      }
      .prose {
        --tw-prose-body: #16213E;
        --tw-prose-headings: #16213E;
        --tw-prose-links: #8B9D83;
        --tw-prose-bold: #16213E;
        --tw-prose-counters: #16213E;
        --tw-prose-bullets: #16213E;
        --tw-prose-quotes: #16213E;
        color: #16213E !important;
      }
      .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
        color: #16213E !important;
      }
      .prose p, .prose li, .prose td, .prose th {
        color: #16213E !important;
      }
      .prose a {
        color: #8B9D83 !important;
      }
    </style>
  </head>
  <body
    class="flex flex-col min-h-screen mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 relative"
  >
    <div class="page-bg"></div>
    <Header />
    <main class="flex-grow z-10 relative">
      <slot />
    </main>
    <Footer />
  </body>
</html>
