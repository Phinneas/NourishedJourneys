    <div id="bb-timer" style="margin:2.5rem 0;padding:2rem 1.5rem;background:#EDEAE3;border-radius:12px;text-align:center;font-family:inherit">
      <p style="margin:0 0 1.25rem;font-size:0.8rem;color:#16213E;letter-spacing:0.08em;text-transform:uppercase">box breathing timer</p>
      <div id="bb-square" style="position:relative;width:160px;height:160px;margin:0 auto 1.5rem;border:2px solid #8B9D83;border-radius:4px">
        <div id="bb-dot" style="position:absolute;width:14px;height:14px;background:#8B9D83;border-radius:50%;top:-7px;left:-7px"></div>
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px">
          <span id="bb-label" style="font-size:0.9rem;font-weight:500;color:#8B9D83;letter-spacing:0.03em">ready</span>
          <span id="bb-count" style="font-size:2.25rem;font-weight:300;color:#8B9D83;line-height:1">—</span>
        </div>
      </div>
      <button id="bb-btn" onclick="bbStart()" style="padding:0.6rem 1.75rem;background:#8B9D83;color:#fff;border:none;border-radius:6px;font-size:0.875rem;font-family:inherit;cursor:pointer;letter-spacing:0.02em">start</button>
      <p id="bb-rounds" style="margin:0.75rem 0 0;font-size:0.8rem;color:#9A9A9A">round — of 4</p>
    </div>
    <script is:inline>
    (function(){
      var phases=[{name:'inhale',count:4},{name:'hold',count:4},{name:'exhale',count:4},{name:'hold',count:4}];
      var phase=0,tick=0,round=0,total=4,timer=null,running=false;
      var dot=document.getElementById('bb-dot');
      var label=document.getElementById('bb-label');
      var countEl=document.getElementById('bb-count');
      var btn=document.getElementById('bb-btn');
      var roundsEl=document.getElementById('bb-rounds');
      var W=160,corners=[[0,0],[W,0],[W,W],[0,W]];
      function pos(ph,t){var p=ph%4,frac=t/4,s=corners[p],e=corners[(p+1)%4];return{x:s[0]+(e[0]-s[0])*frac,y:s[1]+(e[1]-s[1])*frac};}
      function moveDot(ph,t){var p=pos(ph,t);dot.style.left=(p.x-7)+'px';dot.style.top=(p.y-7)+'px';}
      function step(){
        moveDot(phase,tick);
        label.textContent=phases[phase].name;
        countEl.textContent=phases[phase].count-tick;
        tick++;
        if(tick>phases[phase].count){tick=0;phase++;
          if(phase>=4){phase=0;round++;
            if(round>=total){stop();return;}
            roundsEl.textContent='round '+(round+1)+' of '+total;
          }
        }
      }
      function stop(){clearInterval(timer);running=false;label.textContent='done';countEl.textContent='✓';btn.textContent='start again';btn.onclick=function(){round=0;phase=0;tick=0;bbStart();};roundsEl.textContent='4 rounds complete';}
      window.bbStart=function(){
        if(running){clearInterval(timer);running=false;btn.textContent='start';label.textContent='ready';countEl.textContent='—';return;}
        round=0;phase=0;tick=0;roundsEl.textContent='round 1 of '+total;running=true;btn.textContent='stop';step();timer=setInterval(step,1000);
      };
    })();
    </script>
