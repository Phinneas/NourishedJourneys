                flex-direction: column;
            }

            .newsletter-form button {
                width: 100%;
            }

            .footer-top {
                flex-direction: column;
            }
        }

        /* Subtle entrance animations */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .fade-in.visible {
            opacity: 1;
