---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@consts";

const allPosts = await getCollection("posts");
allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const recentPosts = allPosts.slice(0, 6);

const topics = [
  { label: "Meditation for beginners", href: "/tag/Meditation/1/" },
  { label: "Brain fog & mental clarity", href: "/tag/Brain%20Fog/1/" },
  { label: "Journaling techniques", href: "/tag/Journaling/1/" },
  { label: "Breathwork & pranayama", href: "/tag/Yoga/1/" },
  { label: "Attention & focus", href: "/tag/Attention/1/" },
  { label: "Mindfulness practices", href: "/tag/Mindfulness/1/" },
  { label: "Travel & gratitude journals", href: "/tag/Journaling/1/" },
  { label: "Anxiety & stress relief", href: "/tag/Anxiety/1/" },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="max-w-[720px] mx-auto px-4 sm:px-8 pb-16">

    <!-- Hero -->
    <section class="py-12 border-b border-base-content/10">
      <p class="text-[11px] font-semibold tracking-[0.12em] uppercase text-primary mb-4">
        Nourished Journeys — Meditation, Journaling &amp; Breathwork
      </p>
      <h1 class="font-serif text-[clamp(28px,5vw,44px)] font-medium leading-[1.2] mb-5">
        Find your calm,<br/><em class="italic text-primary">one breath at a time.</em>
      </h1>
      <p class="text-[17px] leading-[1.75] text-base-content/60 max-w-[560px] mb-8">
        Practical guides for meditation, journaling, and breathwork — written for real
        people with busy minds, not monks on mountaintops.
      </p>
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <a
          href="/page/1/"
          class="inline-block bg-primary text-primary-content rounded-lg px-7 py-3 text-[15px] font-semibold hover:bg-primary/80 transition-colors">
          Start reading free guides &rarr;
        </a>
        <a
          href="/about/"
          class="inline-block border border-base-content/12 text-base-content/60 rounded-lg px-5 py-3 text-[15px] font-medium hover:border-primary hover:text-primary transition-colors">
          About Nourished Journeys
        </a>
      </div>
      <p class="text-[13px] text-base-content/40">No apps required. Just you, a pen, and a few quiet minutes.</p>
    </section>

    <!-- Why Nourished Journeys -->
    <section class="py-12 border-b border-base-content/10">
      <p class="text-[11px] font-semibold tracking-[0.1em] uppercase text-base-content/40 mb-6">
        Why Nourished Journeys
      </p>
      <h2 class="font-serif text-[clamp(20px,3vw,26px)] font-medium mb-3">
        Meditation advice that meets you where you are
      </h2>
      <p class="text-[15px] leading-[1.75] text-base-content/60 mb-8">
        Most wellness content assumes you have an hour, a yoga mat, and perfect silence.
        Real life isn't like that. Nourished Journeys is built around the practices
        that actually fit into a busy day — five-minute meditations, brain dump journaling,
        simple breath techniques you can do at your desk.
      </p>
      <ul class="flex flex-col gap-4">
        {[
          "Techniques that work in 5 minutes — not 50. Short, focused practices for real schedules.",
          "No spiritual jargon. Clear, practical instructions anyone can follow from day one.",
          "Every guide is grounded in neuroscience and contemplative tradition, not Instagram aesthetics.",
        ].map((item) => (
          <li class="flex items-start gap-3 text-[15px] leading-[1.65] text-base-content/60">
            <span class="flex-shrink-0 mt-[3px] w-[22px] h-[22px] rounded-full bg-primary/15 flex items-center justify-center">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"/>
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Topics -->
    <section class="py-12 border-b border-base-content/10">
      <p class="text-[11px] font-semibold tracking-[0.1em] uppercase text-base-content/40 mb-6">
        What you'll find here
      </p>
      <h2 class="font-serif text-[clamp(20px,3vw,26px)] font-medium mb-3">
        From brain fog to breathwork
      </h2>
      <p class="text-[15px] leading-[1.75] text-base-content/60 mb-6">
        Whether you're trying to clear mental cloudiness, start your first journal,
        or just figure out how to sit still for five minutes — we've got a guide for it.
      </p>
      <div class="flex flex-wrap gap-2">
        {topics.map((t) => (
          <a
            href={t.href}
            class="inline-block bg-primary/10 text-primary rounded-full px-4 py-[6px] text-[13px] font-medium hover:bg-primary hover:text-primary-content transition-colors">
            {t.label}
          </a>
        ))}
      </div>
    </section>

    <!-- Recent posts -->
    {recentPosts.length > 0 && (
      <section class="py-12 border-b border-base-content/10">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-[11px] font-semibold tracking-[0.1em] uppercase text-base-content/40 mb-1">
              Latest
            </p>
            <h2 class="font-serif text-[clamp(20px,3vw,26px)] font-medium">
              From the Journal
            </h2>
          </div>
          <a href="/page/1/" class="text-[13px] text-primary hover:text-primary/80 font-medium transition-colors">
            View all &rarr;
          </a>
        </div>
        <div class="grid gap-8 sm:grid-cols-2">
          {recentPosts.slice(0, 6).map((post) => (
            <a href={`/${post.data.slug}/`} class="group block">
              <article class="flex flex-col gap-3">
                <div class="flex items-center gap-2 text-xs text-base-content/50">
                  <FormattedDate date={post.data.pubDate} />
                  {post.data.tags.length > 0 && (
                    <span class="badge badge-outline badge-sm">{post.data.tags[0]}</span>
                  )}
                </div>
                <h3 class="font-serif text-[17px] font-medium leading-[1.35] group-hover:text-primary transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-[14px] leading-[1.6] text-base-content/60 line-clamp-2">
                  {post.data.description}
                </p>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Newsletter signup -->
    <section class="py-12">
      <div class="bg-primary/10 rounded-xl p-10">
        <h2 class="font-serif text-[clamp(20px,3vw,24px)] font-medium mb-2">
          Get mindfulness prompts in your inbox
        </h2>
        <p class="text-[14px] text-primary/70 leading-[1.65] mb-5">
          A new journaling prompt, meditation technique, or breathing exercise every week.
          Short enough to read on a coffee break.
        </p>
        <form class="flex flex-wrap gap-2" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            aria-label="Email address"
            class="flex-1 min-w-[200px] border border-primary/20 rounded-lg px-4 py-[10px] text-[14px] bg-base-100 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
          />
          <button
            type="submit"
            class="bg-primary text-primary-content rounded-lg px-6 py-[10px] text-[14px] font-semibold hover:bg-primary/80 transition-colors whitespace-nowrap">
            Subscribe free
          </button>
        </form>
        <p class="text-[12px] text-primary/40 mt-3">No spam. Unsubscribe any time.</p>
      </div>
    </section>

  </div>
</BaseLayout>
