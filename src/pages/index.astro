---
import { getCollection } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@consts";

const allPosts = await getCollection("posts");
allPosts.sort(
  (a: any, b: any) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const recentPosts = allPosts.slice(0, 3);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{SITE_TITLE} — Meditation, Breathwork & Journaling</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <meta name="google-site-verification" content="H_QRAwww2BrW3OZ6G4p7wuIh7ZIQ4fVM4h7JRKOts5g" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #FAFFD8;
            --bg-secondary: #ECFFB0;
            --bg-card: #FFFFFF;
            --text-primary: #54577C;
            --text-secondary: #54577C;
            --text-muted: #9AA899;
            --accent-sage: #4A7B9D;
            --accent-sage-light: #6B97B5;
            --accent-sand: #9AA899;
            --accent-sand-light: #B8C5B7;
            --accent-grape: #54577C;
            --accent-amber: #FFB100;
            --accent-lime: #ECFFB0;
            --border: #C8DBA0;
            --border-light: #DFF2B8;
            --shadow-soft: 0 2px 12px rgba(84, 87, 124, 0.07);
            --shadow-medium: 0 4px 24px rgba(84, 87, 124, 0.12);
            --radius: 12px;
            --radius-sm: 8px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.65;
            font-weight: 400;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
        }

        /* Typography */
        h1, h2, h3, h4 {
            font-family: 'Fraunces', Georgia, serif;
            font-weight: 500;
            line-height: 1.2;
            color: var(--text-primary);
        }

        h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
        h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); }
        h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); }
        h4 { font-size: 1.1rem; }

        p {
            color: var(--text-secondary);
            font-size: 1.05rem;
            line-height: 1.7;
            font-weight: 450;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: var(--transition);
        }

        /* Navigation */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            padding: 1.2rem 4%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(250, 255, 216, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid transparent;
            transition: var(--transition);
        }

        .nav.scrolled {
            border-bottom-color: var(--border-light);
            box-shadow: 0 1px 20px rgba(44, 44, 44, 0.04);
        }

        .nav-logo {
            font-family: 'Fraunces', serif;
            font-size: 1.88rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }

        .nav-links a {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-secondary);
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1.5px;
            background: var(--accent-sage);
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--text-primary);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Nav dropdown */
        .nav-dropdown {
            position: relative;
        }

        .nav-dropdown > a,
        .nav-dropdown > button {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-secondary);
            background: none;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            position: relative;
            font-family: inherit;
        }

        .nav-dropdown > a::after,
        .nav-dropdown > button::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1.5px;
            background: var(--accent-sage);
            transition: var(--transition);
        }

        .nav-dropdown:hover > a,
        .nav-dropdown:hover > button {
            color: var(--text-primary);
        }

        .nav-dropdown:hover > a::after,
        .nav-dropdown:hover > button::after {
            width: 100%;
        }

        .nav-dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 50%;
            transform: translateX(-50%);
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 8px 30px rgba(22, 33, 62, 0.12);
            border: 1px solid var(--border-light);
            min-width: 160px;
            padding: 0.4rem 0;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s, visibility 0.2s;
            z-index: 200;
        }

        .nav-dropdown:hover .nav-dropdown-menu {
            opacity: 1;
            visibility: visible;
        }

        .nav-dropdown-menu a {
            display: block;
            padding: 0.55rem 1.1rem;
            font-size: 0.88rem;
            color: var(--text-secondary);
            white-space: nowrap;
        }

        .nav-dropdown-menu a:hover {
            color: var(--text-primary);
            background: var(--bg-secondary);
        }

        .nav-dropdown-menu a::after {
            display: none;
        }

        .nav-cta {
            background: var(--text-primary);
            color: var(--bg-primary);
            padding: 0.6rem 1.4rem;
            border-radius: 100px;
            font-size: 0.85rem;
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-cta:hover {
            background: var(--accent-sage);
            transform: translateY(-1px);
        }

        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 8rem 6% 4rem;
            position: relative;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse at 70% 50%, rgba(74, 123, 157, 0.1) 0%, transparent 55%),
                radial-gradient(ellipse at 20% 30%, rgba(236, 255, 176, 0.6) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            display: flex;
            align-items: center;
            gap: 5rem;
        }

        .hero-left {
            flex: 1;
            min-width: 0;
        }

        .hero-right {
            flex: 0 0 440px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.25rem;
        }

        .hero-label {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--accent-sage);
            margin-bottom: 1.75rem;
        }

        .hero h1 {
            margin-bottom: 1.5rem;
            letter-spacing: -0.02em;
        }

        .hero h1 em {
            font-style: italic;
            color: var(--accent-sage);
        }

        .hero-subtitle {
            font-size: clamp(1rem, 1.8vw, 1.2rem);
            color: var(--text-secondary);
            margin-bottom: 2.5rem;
            max-width: 520px;
            line-height: 1.7;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        .hero-trust {
            font-size: 0.8rem;
            color: var(--text-muted);
            letter-spacing: 0.02em;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.85rem 1.75rem;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: var(--transition);
            cursor: pointer;
            border: none;
            font-family: inherit;
        }

        .btn-primary {
            background: var(--accent-amber);
            color: #1a1a1a;
        }

        .btn-primary:hover {
            background: #e6a000;
            transform: translateY(-2px);
            box-shadow: var(--shadow-medium);
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-primary);
            border: 1.5px solid var(--border);
        }

        .btn-secondary:hover {
            border-color: var(--accent-sage);
            color: var(--accent-sage);
            transform: translateY(-2px);
        }

        /* Breathing Circle */
        .hero-breathe {
            width: 400px;
            height: 400px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .breathe-ring {
            position: absolute;
            border-radius: 50%;
            border: 1.5px solid var(--accent-sage);
        }

        .breathe-ring--outer {
            width: 100%;
            height: 100%;
            opacity: 0.12;
            background: rgba(74, 123, 157, 0.04);
            animation: breathe-expand 8s ease-in-out infinite;
        }

        .breathe-ring--mid {
            width: 70%;
            height: 70%;
            opacity: 0.25;
            background: rgba(74, 123, 157, 0.07);
            animation: breathe-expand 8s ease-in-out infinite 0.4s;
        }

        .breathe-ring--inner {
            width: 42%;
            height: 42%;
            opacity: 0.45;
            background: rgba(74, 123, 157, 0.12);
            animation: breathe-expand 8s ease-in-out infinite 0.8s;
        }

        .breathe-core {
            width: 22%;
            height: 22%;
            background: var(--accent-amber);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: breathe-core 8s ease-in-out infinite;
            position: relative;
            z-index: 1;
        }

        .breathe-core span {
            font-size: 0.7rem;
            font-weight: 500;
            color: var(--bg-primary);
            letter-spacing: 0.08em;
            font-family: 'Instrument Sans', sans-serif;
        }

        @keyframes breathe-expand {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.18); }
        }

        @keyframes breathe-core {
            0%, 100% { transform: scale(1); opacity: 0.85; }
            50% { transform: scale(1.08); opacity: 1; }
        }

        .breathe-caption {
            font-size: 0.75rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 500;
            font-family: 'Instrument Sans', sans-serif;
        }

        .breathe-hint {
            font-size: 0.7rem;
            color: var(--border);
            font-family: 'Instrument Sans', sans-serif;
            margin-top: -0.5rem;
        }

        .hero-scroll {
            position: absolute;
            bottom: calc(2rem + 10px);
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            font-size: 0.8rem;
            animation: float 3s ease-in-out infinite;
        }

        .hero-scroll svg {
            width: 20px;
            height: 20px;
        }

        @keyframes float {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(8px); }
        }

        /* Trust Bar */
        .trust-bar {
            background: var(--bg-secondary);
            padding: 1.2rem 4%;
            text-align: center;
            border-top: 1px solid var(--border-light);
            border-bottom: 1px solid var(--border-light);
        }

        .trust-bar p {
            font-size: 0.85rem;
            color: var(--text-muted);
            letter-spacing: 0.02em;
        }

        .trust-bar strong {
            color: var(--text-secondary);
            font-weight: 500;
        }

        /* Section Base */
        .section {
            padding: 5rem 4%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .section-label {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--accent-sage);
            margin-bottom: 1rem;
        }

        .section-header h2 {
            max-width: 500px;
            margin: 0 auto;
        }

        /* Pillar Bento Grid */
        .pillars {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            grid-template-rows: auto auto;
            gap: 1.25rem;
        }

        .pillars .pillar-card:nth-child(1) {
            grid-column: 1;
            grid-row: 1 / 3;
            background: var(--accent-grape);
            border-color: var(--accent-grape);
        }

        .pillars .pillar-card:nth-child(1) h3,
        .pillars .pillar-card:nth-child(1) p {
            color: #FAFFD8;
        }

        .pillars .pillar-card:nth-child(1) .pillar-icon {
            background: rgba(250, 255, 216, 0.12);
        }

        .pillars .pillar-card:nth-child(1) .pillar-link {
            color: #ECFFB0;
        }

        .pillars .pillar-card:nth-child(1)::before {
            background: #ECFFB0;
        }

        .pillars .pillar-card:nth-child(1):hover {
            border-color: var(--accent-grape);
        }

        .pillars .pillar-card:nth-child(2) {
            grid-column: 2;
            grid-row: 1;
            background: var(--accent-sage);
            border-color: var(--accent-sage);
        }

        .pillars .pillar-card:nth-child(2) h3,
        .pillars .pillar-card:nth-child(2) p {
            color: #FAFFD8;
        }

        .pillars .pillar-card:nth-child(2) .pillar-icon {
            background: rgba(250, 255, 216, 0.15);
        }

        .pillars .pillar-card:nth-child(2) .pillar-link {
            color: #FAFFD8;
        }

        .pillars .pillar-card:nth-child(2)::before {
            background: #FAFFD8;
        }

        .pillars .pillar-card:nth-child(2):hover {
            border-color: var(--accent-sage);
        }

        .pillars .pillar-card:nth-child(3) {
            grid-column: 2;
            grid-row: 2;
            background: var(--bg-secondary);
            border-color: var(--border);
        }

        .pillars .pillar-card:nth-child(3) h3 {
            color: var(--accent-grape);
        }

        .pillar-card {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: var(--radius);
            padding: 2.5rem 2rem;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .pillar-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--accent-sage);
            transform: scaleX(0);
            transform-origin: left;
            transition: var(--transition);
        }

        .pillar-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-medium);
            border-color: var(--border);
        }

        .pillar-card:hover::before {
            transform: scaleX(1);
        }

        .pillar-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-sm);
            background: var(--bg-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            font-size: 1.4rem;
        }

        .pillar-card h3 {
            margin-bottom: 0.75rem;
        }

        .pillar-card p {
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
        }

        .pillar-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--accent-sage);
            transition: var(--transition);
        }

        .pillar-link:hover {
            gap: 0.7rem;
            color: var(--text-primary);
        }

        .pillar-link svg {
            width: 16px;
            height: 16px;
            transition: var(--transition);
        }

        /* Featured Practice */
        .featured {
            background: var(--bg-secondary);
            border-radius: var(--radius);
            padding: 3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            margin-top: 2rem;
            border: 1px solid var(--border-light);
        }

        .featured-badge {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--accent-sand);
            background: rgba(212, 163, 115, 0.12);
            padding: 0.4rem 0.9rem;
            border-radius: 100px;
            margin-bottom: 1.2rem;
        }

        .featured h3 {
            font-size: clamp(1.5rem, 2.5vw, 2rem);
            margin-bottom: 1rem;
        }

        .featured p {
            margin-bottom: 1.5rem;
            font-size: 1rem;
        }

        .featured-meta {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .featured-meta span {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .featured-visual {
            position: relative;
            aspect-ratio: 4/3;
            border-radius: var(--radius);
            overflow: hidden;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--border) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .breathing-animation {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 2px solid var(--accent-sage);
            position: relative;
            animation: breathe 8s ease-in-out infinite;
        }

        .breathing-animation::before,
        .breathing-animation::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            border: 1.5px solid var(--accent-sage-light);
            opacity: 0.4;
        }

        .breathing-animation::before {
            inset: -20px;
            animation: breathe 8s ease-in-out infinite 0.5s;
        }

        .breathing-animation::after {
            inset: -40px;
            border-color: var(--accent-sand-light);
            opacity: 0.25;
            animation: breathe 8s ease-in-out infinite 1s;
        }

        @keyframes breathe {
            0%, 100% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.3); opacity: 0.4; }
        }

        .featured-visual-label {
            position: absolute;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        /* Method Grid - Bento */
        .method-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 1.5rem;
        }

        .method-card:first-child {
            grid-column: 1 / 3;
        }

        .method-card {
            text-align: center;
            padding: 2rem;
            border-radius: var(--radius);
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            transition: var(--transition);
        }

        .method-card:hover {
            box-shadow: var(--shadow-soft);
            transform: translateY(-2px);
        }

        .method-number {
            font-family: 'Fraunces', serif;
            font-size: 2.5rem;
            font-weight: 400;
            color: var(--accent-amber);
            margin-bottom: 1rem;
            line-height: 1;
        }

        .method-card h4 {
            margin-bottom: 0.75rem;
            font-family: 'Instrument Sans', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .method-card p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* Journal Grid - Bento */
        .journal-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 1.5rem;
        }

        .journal-card:first-child {
            grid-column: 1;
            grid-row: 1 / 3;
        }

        .journal-card {
            border-radius: var(--radius);
            overflow: hidden;
            transition: var(--transition);
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            min-height: 260px;
        }

        .journal-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-medium);
            color: inherit;
        }

        .journal-card {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
        }

        .journal-image {
            aspect-ratio: 16/10;
            overflow: hidden;
            background: var(--bg-secondary);
            flex-shrink: 0;
        }

        .journal-card:first-child .journal-image {
            aspect-ratio: 3/2;
            flex-grow: 1;
        }

        .journal-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.5s ease;
        }

        .journal-card:hover .journal-image img {
            transform: scale(1.04);
        }

        .journal-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
        }

        .journal-tag {
            display: inline-block;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 0.75rem;
        }

        .journal-card:nth-child(1) .journal-tag { color: var(--accent-grape); }
