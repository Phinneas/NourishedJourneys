---
import { getCollection } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@consts";

const allPosts = await getCollection("posts");
allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

const recentPosts = allPosts.slice(0, 3);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{SITE_TITLE} — Meditation, Breathwork & Journaling</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #F7F5F0;
            --bg-secondary: #EDEAE3;
            --bg-card: #FFFFFF;
            --text-primary: #2C2C2C;
            --text-secondary: #6B6B6B;
            --text-muted: #9A9A9A;
            --accent-sage: #8B9D83;
            --accent-sage-light: #A8B8A0;
            --accent-sand: #D4A373;
            --accent-sand-light: #E4C9A8;
            --border: #E0DDD6;
            --border-light: #EBE8E1;
            --shadow-soft: 0 2px 12px rgba(44, 44, 44, 0.06);
            --shadow-medium: 0 4px 24px rgba(44, 44, 44, 0.08);
            --radius: 12px;
            --radius-sm: 8px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.65;
            font-weight: 400;
            -webkit-font-smoothing: antialiased;
        }

        /* Typography */
        h1, h2, h3, h4 {
            font-family: 'Crimson Pro', Georgia, serif;
            font-weight: 500;
            line-height: 1.2;
            color: var(--text-primary);
        }

        h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
        h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); }
        h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); }
        h4 { font-size: 1.1rem; }

        p {
            color: var(--text-secondary);
            font-size: 1.05rem;
            line-height: 1.7;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: var(--transition);
        }

        /* Navigation */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            padding: 1.2rem 4%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(247, 245, 240, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid transparent;
            transition: var(--transition);
        }

        .nav.scrolled {
            border-bottom-color: var(--border-light);
            box-shadow: 0 1px 20px rgba(44, 44, 44, 0.04);
        }

        .nav-logo {
            font-family: 'Crimson Pro', serif;
            font-size: 1.3rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }

        .nav-links a {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-secondary);
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 1.5px;
            background: var(--accent-sage);
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--text-primary);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-cta {
            background: var(--text-primary);
            color: var(--bg-primary);
            padding: 0.6rem 1.4rem;
            border-radius: 100px;
            font-size: 0.85rem;
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-cta:hover {
            background: var(--accent-sage);
            transform: translateY(-1px);
        }

        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 8rem 4% 4rem;
            position: relative;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(ellipse at 20% 50%, rgba(139, 157, 131, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 30%, rgba(212, 163, 115, 0.06) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 80%, rgba(139, 157, 131, 0.05) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 680px;
        }

        .hero-label {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--accent-sage);
            margin-bottom: 2rem;
            padding: 0.5rem 1rem;
            border: 1px solid var(--border);
            border-radius: 100px;
        }

        .hero h1 {
            margin-bottom: 1.5rem;
            letter-spacing: -0.02em;
        }

        .hero h1 em {
            font-style: italic;
            color: var(--accent-sage);
        }

        .hero-subtitle {
            font-size: clamp(1.1rem, 2vw, 1.35rem);
            color: var(--text-secondary);
            margin-bottom: 2.5rem;
            max-width: 540px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.9rem 2rem;
            border-radius: 100px;
            font-size: 0.95rem;
            font-weight: 500;
            transition: var(--transition);
            cursor: pointer;
            border: none;
            font-family: inherit;
        }

        .btn-primary {
            background: var(--text-primary);
            color: var(--bg-primary);
        }

        .btn-primary:hover {
            background: var(--accent-sage);
            transform: translateY(-2px);
            box-shadow: var(--shadow-medium);
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-primary);
            border: 1.5px solid var(--border);
        }

        .btn-secondary:hover {
            border-color: var(--accent-sage);
            color: var(--accent-sage);
            transform: translateY(-2px);
        }

        .hero-scroll {
            position: absolute;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            font-size: 0.8rem;
            animation: float 3s ease-in-out infinite;
        }

        .hero-scroll svg {
            width: 20px;
            height: 20px;
        }

        @keyframes float {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(8px); }
        }

        /* Trust Bar */
        .trust-bar {
            background: var(--bg-secondary);
            padding: 1.2rem 4%;
            text-align: center;
            border-top: 1px solid var(--border-light);
            border-bottom: 1px solid var(--border-light);
        }

        .trust-bar p {
            font-size: 0.85rem;
            color: var(--text-muted);
            letter-spacing: 0.02em;
        }

        .trust-bar strong {
            color: var(--text-secondary);
            font-weight: 500;
        }

        /* Section Base */
        .section {
            padding: 5rem 4%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .section-label {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--accent-sage);
            margin-bottom: 1rem;
        }

        .section-header h2 {
            max-width: 500px;
            margin: 0 auto;
        }

        /* Pillar Grid */
        .pillars {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .pillar-card {
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            border-radius: var(--radius);
            padding: 2.5rem 2rem;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .pillar-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--accent-sage);
            transform: scaleX(0);
            transform-origin: left;
            transition: var(--transition);
        }

        .pillar-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-medium);
            border-color: var(--border);
        }

        .pillar-card:hover::before {
            transform: scaleX(1);
        }

        .pillar-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-sm);
            background: var(--bg-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            font-size: 1.4rem;
        }

        .pillar-card h3 {
            margin-bottom: 0.75rem;
        }

        .pillar-card p {
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
        }

        .pillar-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--accent-sage);
            transition: var(--transition);
        }

        .pillar-link:hover {
            gap: 0.7rem;
            color: var(--text-primary);
        }

        .pillar-link svg {
            width: 16px;
            height: 16px;
            transition: var(--transition);
        }

        /* Featured Practice */
        .featured {
            background: var(--bg-secondary);
            border-radius: var(--radius);
            padding: 3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            margin-top: 2rem;
            border: 1px solid var(--border-light);
        }

        .featured-badge {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--accent-sand);
            background: rgba(212, 163, 115, 0.12);
            padding: 0.4rem 0.9rem;
            border-radius: 100px;
            margin-bottom: 1.2rem;
        }

        .featured h3 {
            font-size: clamp(1.5rem, 2.5vw, 2rem);
            margin-bottom: 1rem;
        }

        .featured p {
            margin-bottom: 1.5rem;
            font-size: 1rem;
        }

        .featured-meta {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .featured-meta span {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .featured-visual {
            position: relative;
            aspect-ratio: 4/3;
            border-radius: var(--radius);
            overflow: hidden;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--border) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .breathing-animation {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 2px solid var(--accent-sage);
            position: relative;
            animation: breathe 8s ease-in-out infinite;
        }

        .breathing-animation::before,
        .breathing-animation::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            border: 1.5px solid var(--accent-sage-light);
            opacity: 0.4;
        }

        .breathing-animation::before {
            inset: -20px;
            animation: breathe 8s ease-in-out infinite 0.5s;
        }

        .breathing-animation::after {
            inset: -40px;
            border-color: var(--accent-sand-light);
            opacity: 0.25;
            animation: breathe 8s ease-in-out infinite 1s;
        }

        @keyframes breathe {
            0%, 100% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.3); opacity: 0.4; }
        }

        .featured-visual-label {
            position: absolute;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        /* Method Section */
        .method-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .method-card {
            text-align: center;
            padding: 2rem;
            border-radius: var(--radius);
            background: var(--bg-card);
            border: 1px solid var(--border-light);
            transition: var(--transition);
        }

        .method-card:hover {
            box-shadow: var(--shadow-soft);
            transform: translateY(-2px);
        }

        .method-number {
            font-family: 'Crimson Pro', serif;
            font-size: 2.5rem;
            font-weight: 400;
            color: var(--accent-sage-light);
            margin-bottom: 1rem;
            line-height: 1;
        }

        .method-card h4 {
            margin-bottom: 0.75rem;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .method-card p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        /* Journal Grid */
        .journal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .journal-card {
            background: var(--bg-card);
            border-radius: var(--radius);
            overflow: hidden;
            border: 1px solid var(--border-light);
            transition: var(--transition);
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
        }

        .journal-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-medium);
            color: inherit;
        }

        .journal-image {
            aspect-ratio: 16/10;
            background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--border) 100%);
            position: relative;
            overflow: hidden;
        }

        .journal-image::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(44,44,44,0.05) 0%, transparent 50%);
        }

        /* Abstract pattern overlays for each card */
        .journal-card:nth-child(1) .journal-image {
            background: linear-gradient(160deg, #E8E4DC 0%, #D4CFC5 50%, #C8C2B8 100%);
        }
        .journal-card:nth-child(2) .journal-image {
            background: linear-gradient(200deg, #DDD8CF 0%, #D0C9BE 50%, #C5BDB0 100%);
        }
        .journal-card:nth-child(3) .journal-image {
            background: linear-gradient(140deg, #E2DDD4 0%, #D5CFC4 50%, #C9C2B6 100%);
        }

        .journal-content {
            padding: 1.5rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .journal-tag {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--accent-sage);
            margin-bottom: 0.75rem;
        }

        .journal-card h4 {
            font-family: 'Crimson Pro', serif;
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            line-height: 1.3;
        }

        .journal-meta {
            display: flex;
            gap: 1rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: auto;
            padding-top: 1rem;
        }

        .view-all {
            text-align: center;
            margin-top: 2.5rem;
        }

        /* Newsletter */
        .newsletter-section {
            background: var(--bg-secondary);
            border-radius: var(--radius);
            padding: 4rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            border: 1px solid var(--border-light);
        }

        .newsletter-visual {
            position: relative;
            aspect-ratio: 1;
            max-width: 320px;
            margin: 0 auto;
        }

        .notebook-mockup {
            width: 100%;
            height: 100%;
            background: var(--bg-card);
            border-radius: var(--radius-sm);
            box-shadow: 
                0 1px 2px rgba(0,0,0,0.04),
                0 4px 8px rgba(0,0,0,0.04),
                0 8px 16px rgba(0,0,0,0.03);
            position: relative;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .notebook-lines {
            padding: 2rem 1.5rem;
        }

        .notebook-lines .line {
            height: 2px;
            background: var(--border-light);
            margin-bottom: 1rem;
            border-radius: 1px;
        }

        .notebook-lines .line:nth-child(1) { width: 60%; }
        .notebook-lines .line:nth-child(2) { width: 85%; }
        .notebook-lines .line:nth-child(3) { width: 45%; }
        .notebook-lines .line:nth-child(4) { width: 70%; }
        .notebook-lines .line:nth-child(5) { width: 55%; }
        .notebook-lines .line:nth-child(6) { width: 80%; }
        .notebook-lines .line:nth-child(7) { width: 40%; }

        .pen {
            position: absolute;
            bottom: -10px;
            right: -15px;
            width: 60px;
            height: 180px;
            background: linear-gradient(to bottom, var(--text-secondary) 0%, var(--text-primary) 100%);
            border-radius: 4px;
            transform: rotate(-15deg);
            box-shadow: 2px 4px 12px rgba(0,0,0,0.1);
        }

        .pen::before {
            content: '';
            position: absolute;
            top: -8px;
            left: 50%;
            transform: translateX(-50%);
            width: 16px;
            height: 16px;
            background: var(--accent-sand);
            border-radius: 50%;
        }

        .newsletter-content h2 {
            margin-bottom: 1rem;
        }

        .newsletter-content p {
            margin-bottom: 1.5rem;
        }

        .testimonial {
            background: var(--bg-card);
            border-left: 3px solid var(--accent-sage);
            padding: 1.25rem 1.5rem;
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
            margin-bottom: 2rem;
        }

        .testimonial p {
            font-family: 'Crimson Pro', serif;
            font-size: 1.15rem;
            font-style: italic;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
            line-height: 1.5;
        }

        .testimonial cite {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-style: normal;
            font-family: 'Inter', sans-serif;
        }

        .newsletter-form {
            display: flex;
            gap: 0.75rem;
        }

        .newsletter-form input {
            flex: 1;
            padding: 0.9rem 1.2rem;
            border: 1.5px solid var(--border);
            border-radius: 100px;
            background: var(--bg-card);
            font-family: inherit;
            font-size: 0.95rem;
            color: var(--text-primary);
            outline: none;
            transition: var(--transition);
        }

        .newsletter-form input:focus {
            border-color: var(--accent-sage);
            box-shadow: 0 0 0 3px rgba(139, 157, 131, 0.1);
        }

        .newsletter-form input::placeholder {
            color: var(--text-muted);
        }

        .newsletter-form button {
            padding: 0.9rem 1.8rem;
            background: var(--text-primary);
            color: var(--bg-primary);
            border: none;
            border-radius: 100px;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
        }

        .newsletter-form button:hover {
            background: var(--accent-sage);
            transform: translateY(-1px);
        }

        .newsletter-note {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 1rem;
        }

        /* Footer */
        .footer {
            background: var(--text-primary);
            color: var(--bg-secondary);
            padding: 4rem 4% 2rem;
            margin-top: 4rem;
        }

        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 3rem;
            flex-wrap: wrap;
            gap: 2rem;
        }

        .footer-brand {
            font-family: 'Crimson Pro', serif;
            font-size: 1.5rem;
            color: var(--bg-primary);
            margin-bottom: 0.5rem;
        }

        .footer-tagline {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .footer-links {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: var(--bg-secondary);
            font-size: 0.9rem;
            opacity: 0.7;
            transition: var(--transition);
        }

        .footer-links a:hover {
            opacity: 1;
            color: var(--accent-sage-light);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-bottom p {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .footer-bottom a {
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        .footer-bottom a:hover {
            color: var(--bg-secondary);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .hero {
                padding: 6rem 5% 3rem;
            }

            .featured,
            .newsletter-section {
                grid-template-columns: 1fr;
                padding: 2rem;
                gap: 2rem;
