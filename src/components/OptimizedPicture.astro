---
interface Props {
  src: string;
  alt: string;
  class?: string;
}

const {
  src,
  alt,
  class: className = "mx-auto w-full max-w-full object-cover"
} = Astro.props;

const hasImage = src && src.trim() !== '';
---

{hasImage ? (
  <img
    src={src}
    alt={alt}
    class={className}
    loading="lazy"
    decoding="async"
  />
) : (
  <div class:list={[className, "bg-base-300 min-h-[200px] flex items-center justify-center"]}>
    <span class="text-base-content/50 text-sm">No image available</span>
  </div>
)}
