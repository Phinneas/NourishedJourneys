---
interface Props {
  technique: {
    slug: string;
    name: string;
    pattern: { inhale: number; holdIn: number; exhale: number; holdOut: number };
    rounds: number | null;
    accentColor: string;
  };
}

const { technique } = Astro.props;

const inhalePath =
  "M 150,28 C 198,34 242,64 262,108 C 282,152 274,202 246,242 C 218,282 168,292 118,274 C 68,256 38,206 36,152 C 34,98 62,48 112,28 C 138,18 150,28 150,28 Z";
const exhalePath =
  "M 150,76 C 182,80 212,98 224,132 C 236,166 228,202 206,228 C 184,254 150,262 116,250 C 82,238 60,206 56,168 C 52,130 68,94 98,74 C 130,58 150,76 150,76 Z";

const speeds = [0.75, 1, 1.25, 1.5];
const sessions = [1, 3, 5, 10];

function fmt(n: number) {
  return n % 1 === 0 ? String(n) : n.toFixed(1).replace(/\.0$/, "");
}

const patternDisplay = [
  { key: "inhale", label: "Inhale", val: technique.pattern.inhale },
  { key: "holdIn", label: "Hold", val: technique.pattern.holdIn },
  { key: "exhale", label: "Exhale", val: technique.pattern.exhale },
  { key: "holdOut", label: "Hold", val: technique.pattern.holdOut },
].filter((p) => p.val > 0);
---

<div class="breathing-visualizer-wrapper" data-technique={JSON.stringify(technique)}>
  <div class="relative mx-auto" style="width:320px; height:320px;">
    <svg viewBox="0 0 300 300" class="w-full h-full" style="overflow:visible;">
      {/* Arc ring */}
      <circle
        cx="150"
        cy="150"
        r="140"
        fill="none"
        stroke={technique.accentColor}
        stroke-width="2"
        stroke-opacity="0.25"
      />
      <circle
        id="bv-arc"
        cx="150"
        cy="150"
        r="140"
        fill="none"
        stroke={technique.accentColor}
        stroke-width="3"
        stroke-linecap="round"
        stroke-dasharray="879.65"
        stroke-dashoffset="0"
        transform="rotate(-90 150 150)"
        style="transition: stroke-dashoffset 0.1s linear;"
      />
      {/* Morphing shape */}
      <path
        id="bv-shape"
        d={exhalePath}
        fill={technique.accentColor}
        fill-opacity="0.15"
        stroke={technique.accentColor}
        stroke-width="2"
        style="transition: d 0.6s ease-in-out;"
      />
      {/* Hold pulse overlay */}
      <path
        id="bv-pulse"
        d={exhalePath}
        fill={technique.accentColor}
        fill-opacity="0"
        style="pointer-events:none;"
      />
      {/* Phase label */}
      <text
        id="bv-label"
        x="150"
        y="150"
        text-anchor="middle"
        dominant-baseline="middle"
        font-size="18"
        font-weight="500"
        fill="#16213E"
        style="font-family:'Instrument Sans',sans-serif; letter-spacing:0.03em;"
      >
        Ready
      </text>
      {/* Timer */}
      <text
        id="bv-timer"
        x="150"
        y="175"
        text-anchor="middle"
        dominant-baseline="middle"
        font-size="14"
        fill="#54577C"
        style="font-family:'Instrument Sans',sans-serif;"
      >
        —
      </text>
    </svg>
  </div>

  {/* Round / session counter */}
  <div id="bv-counter" class="text-center text-sm text-[#54577C] mt-2 mb-4" style="min-height:1.5em;">
    {technique.rounds ? `Round 1 of ${technique.rounds}` : "3 min session"}
  </div>

  {/* Timing reference strip */}
  <div class="flex justify-center gap-2 flex-wrap mb-6">
    {patternDisplay.map((p, i) => (
      <div
        id={`bv-strip-${p.key}`}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors duration-300"
        style="background:#EDEAE3; color:#54577C;"
      >
        <span>{p.label}</span>
        <span class="font-semibold">{fmt(p.val)}s</span>
      </div>
    ))}
  </div>

  {/* Controls */}
  <div class="space-y-4 max-w-md mx-auto">
    {/* Start / Pause */}
    <div class="text-center">
      <button
        id="bv-btn-start"
        class="px-8 py-3 text-sm font-medium rounded-xl text-white transition-opacity hover:opacity-90"
        style={`background-color: ${technique.accentColor};`}
      >
        Start
      </button>
    </div>

    {/* Speed */}
    <div>
      <p class="text-xs text-[#9A9A9A] mb-2 text-center uppercase tracking-wider">Speed</p>
      <div class="flex justify-center gap-2">
        {speeds.map((s) => (
          <button
            data-speed={s}
            class="bv-speed-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-colors"
            style="background:#EDEAE3; color:#54577C;"
          >
            {s}×
          </button>
        ))}
      </div>
    </div>

    {/* Session length — hidden for round-based techniques */}
    {!technique.rounds && (
      <div id="bv-session-control">
        <p class="text-xs text-[#9A9A9A] mb-2 text-center uppercase tracking-wider">Session length</p>
        <div class="flex justify-center gap-2">
          {sessions.map((m) => (
            <button
              data-session={m}
              class="bv-session-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-colors"
              style="background:#EDEAE3; color:#54577C;"
            >
              {m} min
            </button>
          ))}
        </div>
      </div>
    )}

    {/* Toggles */}
    <div class="flex justify-center gap-4">
      <button
        id="bv-toggle-audio"
        class="flex items-center gap-2 px-3 py-2 text-xs font-medium rounded-lg transition-colors"
        style="background:#EDEAE3; color:#54577C;"
        title="Audio cues"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
        <span>Audio</span>
      </button>
      <button
        id="bv-toggle-haptic"
        class="flex items-center gap-2 px-3 py-2 text-xs font-medium rounded-lg transition-colors"
        style="background:#EDEAE3; color:#54577C;"
        title="Haptic feedback"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h1"/><path d="M6 8h1"/><path d="M6 16h1"/><path d="M21 12h1"/><path d="M17 8h1"/><path d="M17 16h1"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
        <span>Haptics</span>
      </button>
    </div>
  </div>
</div>

<style>
  @keyframes holdPulse {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.12; }
  }
  .bv-hold-pulse {
    animation: holdPulse 2s ease-in-out infinite;
  }
</style>

<script>
  (function () {
    const wrapper = document.querySelector(".breathing-visualizer-wrapper");
    if (!wrapper) return;

    const technique = JSON.parse(wrapper.dataset.technique || "{}");
    const inhalePath =
      "M 150,28 C 198,34 242,64 262,108 C 282,152 274,202 246,242 C 218,282 168,292 118,274 C 68,256 38,206 36,152 C 34,98 62,48 112,28 C 138,18 150,28 150,28 Z";
    const exhalePath =
      "M 150,76 C 182,80 212,98 224,132 C 236,166 228,202 206,228 C 184,254 150,262 116,250 C 82,238 60,206 56,168 C 52,130 68,94 98,74 C 130,58 150,76 150,76 Z";
    const ARC_CIRCUMFERENCE = 879.65;

    const labelEl = document.getElementById("bv-label");
    const timerEl = document.getElementById("bv-timer");
    const shapeEl = document.getElementById("bv-shape");
    const pulseEl = document.getElementById("bv-pulse");
    const arcEl = document.getElementById("bv-arc");
    const counterEl = document.getElementById("bv-counter");
    const btnStart = document.getElementById("bv-btn-start");

    const speedBtns = wrapper.querySelectorAll(".bv-speed-btn");
    const sessionBtns = wrapper.querySelectorAll(".bv-session-btn");
    const audioToggle = document.getElementById("bv-toggle-audio");
    const hapticToggle = document.getElementById("bv-toggle-haptic");

    const stripEls = {
      inhale: document.getElementById("bv-strip-inhale"),
      holdIn: document.getElementById("bv-strip-holdIn"),
      exhale: document.getElementById("bv-strip-exhale"),
      holdOut: document.getElementById("bv-strip-holdOut"),
    };

    const phaseLabels: Record<string, string> = {
      inhale: "Breathe in",
      holdIn: "Hold",
      exhale: "Breathe out",
      holdOut: "Hold",
    };

    const phaseTones: Record<string, number> = {
      inhale: 440,
      holdIn: 330,
      exhale: 220,
      holdOut: 330,
    };

    let speed = 1;
    let sessionMinutes = 3;
    let audioEnabled = false;
    let hapticsEnabled = false;
    let running = false;
    let phaseIndex = 0;
    let elapsedInPhase = 0;
    let cycleCount = 0;
    let round = 1;
    let totalCycles = 0;
    let lastFrameTime = 0;
    let rafId = 0;
    let audioCtx: AudioContext | null = null;

    function getPhases() {
      const p = technique.pattern;
      const phases: { name: string; duration: number }[] = [];
      if (p.inhale > 0) phases.push({ name: "inhale", duration: p.inhale });
      if (p.holdIn > 0) phases.push({ name: "holdIn", duration: p.holdIn });
      if (p.exhale > 0) phases.push({ name: "exhale", duration: p.exhale });
      if (p.holdOut > 0) phases.push({ name: "holdOut", duration: p.holdOut });
      return phases;
    }

    function calculateTotalCycles() {
      if (technique.rounds) {
        return technique.rounds * 30;
      }
      const phases = getPhases();
      const cycleDuration = phases.reduce((s, p) => s + p.duration, 0) * speed;
      const totalDuration = sessionMinutes * 60;
      return Math.max(1, Math.floor(totalDuration / cycleDuration));
    }

    function updateActiveBtn(btns: NodeListOf<Element>, value: number, attr: string) {
      btns.forEach((b) => {
        const btn = b as any;
        const active = parseFloat(btn.dataset[attr] || "0") === value;
        btn.style.background = active ? technique.accentColor : "#EDEAE3";
        btn.style.color = active ? "#fff" : "#54577C";
      });
    }

    function setSpeed(s: number) {
      speed = s;
      updateActiveBtn(speedBtns, s, "speed");
      if (!running && !technique.rounds) {
        totalCycles = calculateTotalCycles();
        updateCounter();
      }
    }

    function setSession(m: number) {
      sessionMinutes = m;
      updateActiveBtn(sessionBtns, m, "session");
      if (!running && !technique.rounds) {
        totalCycles = calculateTotalCycles();
        updateCounter();
      }
    }

    function updateToggle(btn: HTMLElement, active: boolean) {
      btn.style.background = active ? technique.accentColor : "#EDEAE3";
      btn.style.color = active ? "#fff" : "#54577C";
    }

    function updateCounter() {
      if (!counterEl) return;
      if (technique.rounds) {
        counterEl.textContent = `Round ${round} of ${technique.rounds}`;
      } else {
        counterEl.textContent = `${sessionMinutes} min session · Cycle ${cycleCount + 1} of ${totalCycles}`;
      }
    }

    function highlightStrip(phaseName: string) {
      Object.entries(stripEls).forEach(([key, el]) => {
        if (!el) return;
        if (key === phaseName) {
          el.style.background = technique.accentColor;
          el.style.color = "#fff";
        } else {
          el.style.background = "#EDEAE3";
          el.style.color = "#54577C";
        }
      });
    }

    function updateVisuals(phase: { name: string; duration: number }, duration: number) {
      const remaining = Math.max(0, duration - elapsedInPhase);
      const progress = elapsedInPhase / duration;

      if (labelEl) labelEl.textContent = phaseLabels[phase.name] || phase.name;
      if (timerEl) timerEl.textContent = remaining.toFixed(1) + "s";

      // Arc ring
      if (arcEl) {
        arcEl.style.strokeDashoffset = String(ARC_CIRCUMFERENCE * progress);
      }

      // Shape morph
      if (shapeEl) {
        if (phase.name === "inhale") {
          shapeEl.setAttribute("d", inhalePath);
        } else if (phase.name === "exhale") {
          shapeEl.setAttribute("d", exhalePath);
        }
      }
      if (pulseEl) {
        if (phase.name === "inhale") {
          pulseEl.setAttribute("d", inhalePath);
        } else if (phase.name === "exhale") {
          pulseEl.setAttribute("d", exhalePath);
        }
      }

      // Hold pulse
      if (pulseEl) {
        if (phase.name === "holdIn" || phase.name === "holdOut") {
          pulseEl.classList.add("bv-hold-pulse");
        } else {
          pulseEl.classList.remove("bv-hold-pulse");
        }
      }

      highlightStrip(phase.name);
    }

    function playTone(freq: number) {
      if (!audioEnabled) return;
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        const ctx = audioCtx;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.25);
      } catch (e) {
        /* ignore */
      }
    }

    function triggerHaptic() {
      if (!hapticsEnabled) return;
      if (typeof navigator !== "undefined" && navigator.vibrate) {
        navigator.vibrate(50);
      }
    }

    function finish() {
      running = false;
      if (rafId) cancelAnimationFrame(rafId);
      if (labelEl) labelEl.textContent = "Done";
      if (timerEl) timerEl.textContent = "✓";
      if (btnStart) btnStart.textContent = "Start again";
      if (arcEl) arcEl.style.strokeDashoffset = String(ARC_CIRCUMFERENCE);
      if (pulseEl) pulseEl.classList.remove("bv-hold-pulse");
      Object.values(stripEls).forEach((el) => {
        if (!el) return;
        el.style.background = "#EDEAE3";
        el.style.color = "#54577C";
      });
      playTone(528);
    }

    function tick(now: number) {
      if (!running) return;
      const dt = (now - lastFrameTime) / 1000;
      lastFrameTime = now;
      elapsedInPhase += dt;

      const phases = getPhases();
      const currentPhase = phases[phaseIndex];
      const phaseDuration = currentPhase.duration * speed;

      updateVisuals(currentPhase, phaseDuration);
      updateCounter();

      if (elapsedInPhase >= phaseDuration) {
        elapsedInPhase = 0;
        phaseIndex++;

        if (phaseIndex >= phases.length) {
          phaseIndex = 0;
          cycleCount++;

          if (technique.rounds) {
            const breathsPerRound = 30;
            if (cycleCount % breathsPerRound === 0) {
              round++;
              if (round > technique.rounds) {
                finish();
                return;
              }
            }
          } else {
            if (cycleCount >= totalCycles) {
              finish();
              return;
            }
          }
        }

        const nextPhase = phases[phaseIndex];
        playTone(phaseTones[nextPhase.name] || 330);
        triggerHaptic();
      }

      rafId = requestAnimationFrame(tick);
    }

    function start() {
      running = true;
      phaseIndex = 0;
      elapsedInPhase = 0;
      cycleCount = 0;
      round = 1;
      totalCycles = calculateTotalCycles();
      lastFrameTime = performance.now();
      if (btnStart) btnStart.textContent = "Pause";
      playTone(phaseTones.inhale || 440);
      triggerHaptic();
      rafId = requestAnimationFrame(tick);
    }

    function pause() {
      running = false;
      if (rafId) cancelAnimationFrame(rafId);
      if (btnStart) btnStart.textContent = "Resume";
    }

    function toggle() {
      if (running) {
        pause();
      } else {
        start();
      }
    }

    // Init controls
    setSpeed(1);
    if (!technique.rounds) setSession(3);

    speedBtns.forEach((b) => {
      b.addEventListener("click", () => setSpeed(parseFloat((b as any).dataset.speed || "1")));
    });
    sessionBtns.forEach((b) => {
      b.addEventListener("click", () => setSession(parseInt((b as any).dataset.session || "3")));
    });

    if (audioToggle) {
      audioToggle.addEventListener("click", () => {
        audioEnabled = !audioEnabled;
        updateToggle(audioToggle, audioEnabled);
      });
    }
    if (hapticToggle) {
      hapticToggle.addEventListener("click", () => {
        hapticsEnabled = !hapticsEnabled;
        updateToggle(hapticToggle, hapticsEnabled);
      });
    }
    if (btnStart) {
      btnStart.addEventListener("click", toggle);
    }
  })();
</script>
