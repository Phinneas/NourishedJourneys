---
import Link from "@components/Links.astro";
import { SITE_TITLE, HeaderLinks } from "@consts";
---

<header class="z-50 flex w-full flex-wrap py-7 md:flex-nowrap md:justify-start">
  <nav
    class="relative mx-auto flex w-full max-w-7xl basis-full flex-wrap items-center px-4"
    aria-label="Global"
  >
    <div>
      <a
        class="flex-none text-xl font-semibold"
        href="/"
        aria-label={SITE_TITLE}
      >
        {SITE_TITLE}
      </a>
    </div>

    <div class="ms-auto flex items-center gap-x-4 py-1">
      {HeaderLinks.map((link) => (
        <Link href={link.href} class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-black/5 transition-colors">
          {link.title}
        </Link>
      ))}
      <a
        class="inline-flex items-center gap-x-2 rounded-xl border border-transparent px-3 py-2 text-sm font-medium"
        href="/search/"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
    </div>
  </nav>
</header>
