---
import { SITE_TITLE, HeaderLinks } from "@consts";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="z-50 flex w-full flex-wrap py-4 md:flex-nowrap md:justify-start">
  <nav
    class="relative mx-auto flex w-full max-w-7xl basis-full flex-wrap items-center px-4"
    aria-label="Global"
  >
    <div>
      <a
        class="flex-none text-[1.73rem] font-semibold"
        href="/"
        aria-label={SITE_TITLE}
      >
        {SITE_TITLE}
      </a>
    </div>

    <div class="ms-auto flex items-center gap-x-1 py-1">
      <a
        href="/"
        class:list={[
          "px-3 py-2 text-sm font-medium rounded-lg hover:bg-black/5 transition-colors",
          currentPath === "/" && "text-[#8B9D83] font-semibold",
        ]}
        aria-current={currentPath === "/" ? "page" : undefined}
      >
        Home
      </a>
      {HeaderLinks.map((link) => {
        const isActive = link.children
          ? link.children.some((c) => currentPath === c.href.replace(/\/+$/, ""))
          : false;

        return (
          <div class:list={["relative group", isActive && "active"]}>
            <button
              class:list={[
                "px-3 py-2 text-sm font-medium rounded-lg hover:bg-black/5 transition-colors inline-flex items-center gap-1",
                isActive && "text-[#8B9D83] font-semibold",
              ]}
            >
              {link.title}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-1 min-w-[160px]">
                {link.children.map((child) => {
                  const childPath = child.href.replace(/\/+$/, "") || "/";
                  const isChildActive = currentPath === childPath;
                  return (
                    <a
                      href={child.href}
                      class:list={[
                        "block px-4 py-2 text-sm transition-colors",
                        isChildActive
                          ? "bg-[#EDEAE3] font-semibold text-[#8B9D83]"
                          : "hover:bg-black/5",
                      ]}
                      aria-current={isChildActive ? "page" : undefined}
                    >
                      {child.title}
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })}
      <a
        class="inline-flex items-center gap-x-2 rounded-xl px-3 py-2 text-sm font-medium"
        href="/search/"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
    </div>
  </nav>
</header>
